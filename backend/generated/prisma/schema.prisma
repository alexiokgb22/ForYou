generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int          @id @default(autoincrement())
  googleId     String?      @unique @map("google_id")
  email        String       @unique
  name         String
  avatarUrl    String?      @map("avatar_url")
  passwordHash String?      @map("password_hash")
  createdAt    DateTime     @default(now()) @map("created_at")
  collections  Collection[]

  @@map("users")
}

model Collection {
  id          Int         @id @default(autoincrement())
  userId      Int         @map("user_id")
  title       String
  publicToken String      @unique @map("public_token")
  readingMode ReadingMode @default(UNDECIDED) @map("reading_mode")
  unlockDate  DateTime?   @map("unlock_date")
  modeLocked  Boolean     @default(false) @map("mode_locked")
  createdAt   DateTime    @default(now()) @map("created_at")
  user        User        @relation(fields: [userId], references: [id])
  letters     Letter[]

  @@index([userId], map: "collections_user_id_fkey")
  @@map("collections")
}

model Letter {
  id           Int          @id @default(autoincrement())
  collectionId Int          @map("collection_id")
  senderName   String       @map("sender_name")
  senderEmail  String?      @map("sender_email")
  content      String       @db.Text
  theme        String       @default("default")
  designConfig Json?        @map("design_config")
  status       LetterStatus @default(SENT)
  sentAt       DateTime     @default(now()) @map("sent_at")
  openedAt     DateTime?    @map("opened_at")
  collection   Collection   @relation(fields: [collectionId], references: [id])

  @@index([collectionId], map: "letters_collection_id_fkey")
  @@map("letters")
}

enum ReadingMode {
  UNDECIDED
  IMMEDIATE
  SCHEDULED
}

enum LetterStatus {
  SENT
  OPENED
}
